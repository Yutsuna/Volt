@[Extern]
def exit( status : Int32 ) : Nil

@[Extern]
def puts( str : UInt8* ) : Int32

def check_value( n : Int32 ) : Int32
    return -1 unless n > 0
    return 0 if n == 0
    n > 100 ? 100 : n
end

def imbricate( score : Int32 ) : UInt8*
    score > 80 ? "Excellent" : score > 50 ? "Mid" : "Fail"
end

def main : Int32
  val1 = -5
  val2 = 150

  unless check_value( val1 ) == -1
    puts( "Error" )
    return 1
  end

  res = check_value( val2 )
  puts( imbricate( res ) ) unless res == 0

  (res == 100) ? 0 : 1
end

exit main
