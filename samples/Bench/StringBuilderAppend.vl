def bench_string_builder -> UInt64
  total_len = 0_u64
  iter = 0
  while iter < 2_000
    sb = StringBuilder.new( 64_u64 )
    j = 0
    while j < 200
      sb.append_byte( 65_u8 )
      j += 1
    end
    total_len += sb.size
    iter += 1
  end
  total_len
end

res = bench_string_builder()
assert!( res == 400_000_u64 )
