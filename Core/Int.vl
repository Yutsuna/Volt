# Volt Core — Int
#
# Reopens the generic `Int` family (covers Int8/16/32/64 and the inferred
# `Int` kind — see `Type#reopen_names`) to attach `to_string`. Two passes
# over the digits: the first only counts them, so the second can `malloc`
# the exactly-sized buffer up front and fill it forward from `buf` — the
# pointer handed to `String` is then always the literal `malloc` return
# value, which is what `String#finalize` must `free`.

struct Int
  def to_string -> String
    if self == 0
      return "0"
    end

    neg = self < 0
    n   = neg ? ( 0 - self ) : self

    count = 0
    tmp   = n
    while tmp > 0
      tmp   = tmp / 10
      count = count + 1
    end

    total        = neg ? count + 1 : count
    buf : UInt8* = malloc( total )

    idx = total - 1
    rem = n
    while rem > 0
      digit          = rem % 10
      *( buf + idx ) = 48_u8 + digit
      rem            = rem / 10
      idx            = idx - 1
    end
    *( buf + idx ) = 45_u8 if neg

    String.new( buf, total, true )
  end
end
