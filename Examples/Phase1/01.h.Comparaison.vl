def main : Int32
    a = 10
    b = 20

    check1 = (a == 10)  # true
    check2 = (a != b)   # true

    check3 = (a < b)    # true
    check4 = (b > a)    # true
    check5 = (a <= 10)  # true
    check6 = (b >= 20)  # true

    c = true
    d = false

    res_and = (c && d)  # false
    res_or  = (c || d)  # true
    res_not = (!c)      # false

    n1 = 5 # 0101
    n2 = 3 # 0011

    # AND : 0101 & 0011 = 0001 (1)
    b_and = n1 & n2

    # OR : 0101 | 0011 = 0111 (7)
    b_or  = n1 | n2

    # XOR : 0101 ^ 0011 = 0110 (6)
    b_xor = n1 ^ n2

    # NOT : ~5
    b_not = ~n1

    # 5 << 1 = 10 (1010)
    b_shl = n1 << 1

    # 5 >> 1 = 2 (0010)
    b_shr = n1 >> 1

    if (b_and == 1 && b_or == 7 && b_xor == 6 && b_shl == 10 && b_shr == 2)
        return 0
    else
        return 1
    end

end

exit main
