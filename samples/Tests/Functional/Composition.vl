def assert!( condition : Bool ) -> Void
  if not condition
    raise "FAIL #{__FILE__}:\tCalled by #{__FUNCTION__} at #{__LINE__}:#{__COLUMN__}"
  end
end


raw_name = "  VoLt "
name = raw_name |> (&.trim) >> (&.downcase)
assert!( name == "volt" )


users = [ " alice ", "" ]
kept = users.filter( (&.empty?.!) )
assert!( kept.size == 1 )

tidy = users.map( (&.trim) >> (&.prefix("usr_")) )
assert!( tidy[ 0 ] == "usr_alice" )
