@[External( "libc", "exit" )]
external def libc_exit( value : Int32 ) -> Void

# The oracle is the exit code, and it has to be one the runtime cannot fake.
# `raise` cannot be used here: with no enclosing `begin`, tier-1 EH unwinds by
# returning early carrying no value, which for an Int32 body is `ret i32 0` —
# indistinguishable from success by the time `libc_exit( main() )` reads it.
# A failed assertion would exit 0 and the whole corpus would assert nothing.
def assert!( condition : Bool ) -> Void
  if not condition
    libc_exit( 1 )
  end
end

#------------------------------------------------------------------------------

def test_float32 -> Void
  a : Float32 = 10.0
  b : Float32 = 2.5
  neg : Float32 = -5.0
  zero : Float32 = 0.0

  assert!( a + b == 12.5 )
  assert!( a - b == 7.5 )
  assert!( a * b == 25.0 )
  assert!( a / b == 4.0 )
  assert!( neg.abs == 5.0 )
  assert!( neg.negate == 5.0 )
  assert!( a.min( b ) == 2.5 )
  assert!( a.max( b ) == 10.0 )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( neg.negative? )
  assert!( b.square == 6.25 )
  assert!( b.double == 5.0 )
  assert!( a.half == 5.0 )
  assert!( a.distance( b ) == 7.5 )
  assert!( a.clamp( 0.0, 5.0 ) == 5.0 )
end

#------------------------------------------------------------------------------

def main -> Int32
  test_float32
  0
end

libc_exit( main() )
