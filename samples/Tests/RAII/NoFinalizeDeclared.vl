def assert!( condition : Bool ) -> Void
  if not condition
    raise "Assertion failed #{__FILE__}:#{__LINE__}"
  end
end

#------------------------------------------------------------------------------

struct Plain
  getter tag : Int32

  def initialize( @tag : Int32 )
  end
end

def use_plain -> Int32
  p = Plain.new( 42 )
  p.tag
end

#------------------------------------------------------------------------------

struct Holder
  getter label : String

  def initialize( @label : String )
  end
end

def use_holder -> UInt64
  h = Holder.new( "hello-" + "world" )
  h.label.size
end

assert!( use_plain == 42 )
assert!( use_holder == 11_u64 )
