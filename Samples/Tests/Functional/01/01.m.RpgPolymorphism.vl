mixin Upgradable
  def upgrade_stats( hp_bonus : Int64 ) -> Void
    @max_hp += hp_bonus
    @hp += hp_bonus
  end
end

abstract class AHero
  include Upgradable

  name   : String
  hp     : Int64
  max_hp : Int64

  def initialize( @name : String, @hp : Int64 )
    @max_hp = hp
  end

  abstract def use_ability -> String
  abstract def class_type -> String
end

class Paladin < AHero
  shield_points : Int64

  def initialize( @name : String, @hp : Int64, @shield_points : Int64 )
    @max_hp = hp
  end

  def use_ability -> String
    @shield_points = @shield_points + 10
    "Holy Shield active (Shield: " + @shield_points.to_s + ")"
  end

  def class_type -> String
    "Paladin"
  end
end

class Ranger < AHero
  arrows : Int64

  def initialize( @name : String, @hp : Int64, @arrows : Int64 )
    @max_hp = hp
  end

  def use_ability -> String
    if @arrows > 0
      @arrows = @arrows - 1
      "Double Shot! (Arrows remaining: " + @arrows.to_s + ")"
    else
      "Out of arrows!"
    end
  end

  def class_type -> String
    "Ranger"
  end
end

def trigger_hero_action( hero : AHero ) -> Void
  puts( hero.class_type + " " + hero.name + " HP: " + hero.hp.to_s + "/" + hero.max_hp.to_s )
  puts( "Action: " + hero.use_ability )
end

arthas : AHero = Paladin.new( "Arthas", 120, 15 )
sylvanas : AHero = Ranger.new( "Sylvanas", 90, 2 )

trigger_hero_action arthas
trigger_hero_action sylvanas
trigger_hero_action sylvanas
trigger_hero_action sylvanas

arthas.upgrade_stats 30
sylvanas.upgrade_stats 20

trigger_hero_action arthas
trigger_hero_action sylvanas
