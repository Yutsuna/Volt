class Tracked
  id : Int32
  log : Pointer<Int32>
  cursor : Pointer<Int32>

  def initialize( @id : Int32, @log : Pointer<Int32>, @cursor : Pointer<Int32> ) end

  def +( other : Tracked ) -> Tracked
    Tracked.new( @id + other.id, @log, @cursor )
  end

  def finalize -> Void
    slot = *@cursor
    *( @log + slot ) = @id
    *@cursor = slot + 1
  end
end

def consume( t : Tracked ) -> Int32
  t.id
end

def apply( f : Proc<Int32, Int32>, v : Int32 ) -> Int32
  f( v )
end

def argument_temp( log : Pointer<Int32>, cursor : Pointer<Int32> ) -> Int32
  a = Tracked.new( 1, log, cursor )
  b = Tracked.new( 2, log, cursor )

  n = consume( a + b )

  assert!( n == 3 )
  assert!( *cursor == 1 )
  assert!( *( log + 0 ) == 3 )

  n
end

cursor = Pointer<Int32>.malloc( 1 )
*cursor = 0
log = Pointer<Int32>.malloc( 8 )

assert!( argument_temp( log, cursor ) == 3 )
assert!( apply( ( x : Int32 ) => x * 2, 21 ) == 42 )

log.free
cursor.free
