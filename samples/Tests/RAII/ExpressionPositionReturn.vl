class Tracked
  id : Int32
  log : Pointer<Int32>
  cursor : Pointer<Int32>

  def initialize( @id : Int32, @log : Pointer<Int32>, @cursor : Pointer<Int32> ) end

  def finalize -> Void
    slot = *@cursor
    *( @log + slot ) = @id
    *@cursor = slot + 1
  end
end

def expression_return( flag : Bool, log : Pointer<Int32>, cursor : Pointer<Int32> ) -> Int32
  outer = Tracked.new( 1, log, cursor )
  value = if flag
    inner = Tracked.new( 2, log, cursor )
    return 99
  else
    7
  end
  value
end

cursor = Pointer<Int32>.malloc( 1 )
*cursor = 0
log = Pointer<Int32>.malloc( 2 )

result = expression_return( true, log, cursor )

assert!( result == 99 )

assert!( *cursor == 2 )
assert!( *( log + 0 ) == 2 )
assert!( *( log + 1 ) == 1 )

log.free
cursor.free
