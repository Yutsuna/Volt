@[External( "libc", "exit" )]
external def libc_exit( value : Int32 ) -> Void

# The oracle is the exit code, and it has to be one the runtime cannot fake.
# `raise` cannot be used here: with no enclosing `begin`, tier-1 EH unwinds by
# returning early carrying no value, which for an Int32 body is `ret i32 0` —
# indistinguishable from success by the time `libc_exit( main() )` reads it.
# A failed assertion would exit 0 and the whole corpus would assert nothing.
def assert!( condition : Bool ) -> Void
  if not condition
    libc_exit( 1 )
  end
end

#------------------------------------------------------------------------------

def test_float64 -> Void
  a : Float64 = 100.0
  b : Float64 = 25.0
  neg : Float64 = -50.0
  zero : Float64 = 0.0

  assert!( a + b == 125.0 )
  assert!( a - b == 75.0 )
  assert!( a * b == 2500.0 )
  assert!( a / b == 4.0 )
  assert!( neg.abs == 50.0 )
  assert!( neg.negate == 50.0 )
  assert!( a.min( b ) == 25.0 )
  assert!( a.max( b ) == 100.0 )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( neg.negative? )
  assert!( b.square == 625.0 )
  assert!( b.double == 50.0 )
  assert!( a.half == 50.0 )
  assert!( ( 3.0 : Float64 ).cube == 27.0 )
  assert!( a.distance( b ) == 75.0 )
  assert!( a.clamp( 0.0, 50.0 ) == 50.0 )
end

#------------------------------------------------------------------------------

def main -> Int32
  test_float64
  0
end

libc_exit( main() )
