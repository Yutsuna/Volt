@[External( "libc", "read" )]
external def libc_read( fd : Int32, buffer : Pointer<UInt8>, count : UInt64 ) -> Int64

@[External( "libc", "write" )]
external def libc_write( fd : Int32, buffer : Pointer<UInt8>, count : UInt64 ) -> Int64

@[External( "libc", "fsync" )]
external def libc_fsync( fd : Int32 ) -> Int32


module IO


  class StandardStream
    include Reader
    include Writer

    getter fd : Int32

    def initialize( @fd : Int32 )
    end

    def read( buffer : Pointer<UInt8>, count : UInt64 ) -> Int64
      libc_read( @fd, buffer, count )
    end

    def write( buffer : Pointer<UInt8>, count : UInt64 ) -> Int64
      libc_write( @fd, buffer, count )
    end

    def flush -> Void
      libc_fsync( @fd )
    end

  end

  def self.stdin -> StandardStream
    StandardStream.new( 0 )
  end

  def self.stdout -> StandardStream
    StandardStream.new( 1 )
  end

  def self.stderr -> StandardStream
    StandardStream.new( 2 )
  end

end
