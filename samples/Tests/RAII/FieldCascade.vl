class Pair
  getter a : String
  getter b : String

  def initialize( @a : String, @b : String )
  end

  def finalize -> Void
  end
end

class Logger
  getter tag : String
  count : Int32

  def initialize( @tag : String )
    @count = 0
  end

  def finalize -> Void
    @count = -1
  end
end

def use_pair -> UInt64
  p = Pair.new( "hello-" + "world", "foo-" + "bar" )
  p.a.size + p.b.size
end

def use_logger -> UInt64
  l = Logger.new( "prefix-" + "suffix" )
  l.tag.size
end

assert!( use_pair == 18_u64 )
assert!( use_logger == 13_u64 )
