def assert!( condition : Bool ) -> Void
  if not condition
    raise "Assertion failed"
  end
end


# Une variable qui contient une lambda s'appelle comme une fonction normale
double = ( x : Int32 ) => { x * 2 }
add_five = ( &.+ 5 )

# Appel direct via parenthèses ou via pipeline
assert!( double( 4 ) == 8 )
assert!( 4 |> double == 8 )

assert!( add_five( 10 ) == 15 )
assert!( 10 |> add_five == 15 )


# Point (on nomme 'x')
calc_pointed = ( x : Int32 ) => { (x + 10) * 2 }

# Point-Free (aucune variable nommée)
calc_pointfree = ( &.+ 10 ) >> ( &.* 2 )

assert!( calc_pointed( 2 ) == 24 )
assert!( calc_pointfree( 2 ) == 24 )
assert!( 2 |> calc_pointfree == 24 )


# Point (on nomme 's')
clean_pointed = ( s : String ) => { s.trim.downcase.prefix("[user]: ") }

# Point-Free (composition tacite de 3 méthodes)
clean_pointfree = (&.trim)
               >> (&.downcase)
               >> (&.prefix("[user]: "))

assert!( clean_pointfree("  ALICE ") == "[user]: alice" )
assert!( "  BOB " |> clean_pointfree == "[user]: bob" )


module PointFreeDemo

  def self.run -> Void
    numbers = [ 1, 2, 3, 4, 5 ]

    # On passe directement la fonction composée à .map()
    # Aucun 'x' ou 'item' n'est créé dans la boucle !
    results = numbers.map( ( &.+ 10 ) >> ( &.* 2 ) )

    assert!( results[0] == 22 )
    assert!( results[1] == 24 )
    assert!( results[2] == 26 )


    # Combinaison de filtres et map en pur Point-Free :
    # 1. &.trim                  : Nettoie les espaces
    # 2. &.prefix("usr_")        : Ajoute un préfixe
    transform = (&.trim) >> (&.prefix("usr_"))

    raw_users = [ " alice ", " bob ", "   " ]

    # Pipeline complet sans aucune variable temporaire :
    clean_users = raw_users
      .filter( (&.empty?.!) )  # Filtre les chaînes NON vides
      .map( transform )        # Applique la transformation point-free

    assert!( clean_users[0] == "usr_alice" )
    assert!( clean_users[1] == "usr_bob" )
  end

end

PointFreeDemo.run
