@[External("libc")]
def puts( str : String ) -> Int32


abstract class Device
  name : String

  def initialize(name : String)
    @name = name
  end

  abstract def write(data : String) -> Void
end


class UsbDrive < Device
  capacity : Int64

  def initialize(@name : String, @capacity : Int64)
  end

  def write(data : String) -> Void
    puts("WRITE TO USB [" + @name + "] (" + @capacity.to_s + "MB): " + data)
  end
end


class NetworkPrinter < Device
  def write(data : String) -> Void
    puts("PRINT TO NETWORK [" + @name + "]: " + data)
  end
end

def send_data(dev : Device, payload : String) -> Void
  dev.write(payload)
end


usb : Device = UsbDrive.new("FlashDrive", 16384)
printer : Device = NetworkPrinter.new("OfficeJet")

send_data(usb, "kernel_backup.bin")
send_data(printer, "report.pdf")
