class Tracked
  id : Int32
  log : Pointer<Int32>
  cursor : Pointer<Int32>

  def initialize( @id : Int32, @log : Pointer<Int32>, @cursor : Pointer<Int32> ) end

  def finalize -> Void
    slot = *@cursor
    *( @log + slot ) = @id
    *@cursor = slot + 1
  end
end

def loop_exits( log : Pointer<Int32>, cursor : Pointer<Int32> ) -> Int32
  total = 0
  i = 0
  while i < 4
    step = Tracked.new( i + 10, log, cursor )

    add = if i == 1
      i = i + 1
      next
    else
      if i == 2
        break
      else
        step.id
      end
    end

    total = total + add
    i = i + 1
  end
  total
end

cursor = Pointer<Int32>.malloc( 1 )
*cursor = 0
log = Pointer<Int32>.malloc( 8 )

result = loop_exits( log, cursor )

assert!( result == 10 )
assert!( *cursor == 3 )
assert!( *( log + 0 ) == 10 )
assert!( *( log + 1 ) == 11 )
assert!( *( log + 2 ) == 12 )

log.free
cursor.free
