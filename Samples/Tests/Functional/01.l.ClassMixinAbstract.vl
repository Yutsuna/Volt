@[External("libc")]
def puts( str : String ) -> Int32


mixin Taxable
  def calculate_tax(rate : Float64) -> Float64
    @price * rate
  end
end


abstract class AProduct
  name  : String
  price : Float64

  def initialize(@name : String, @price : Float64)
  end

  abstract def description -> String
end


class Book < AProduct include Taxable
  author : String

  def initialize(@name : String, @price : Float64, @author : String)
  end

  def description -> String
    "Book: '" + @name + "' by " + @author
  end
end


class Electronic < AProduct include Taxable
  warranty_months : Int64

  def initialize(name : String, price : Float64, warranty_months : Int64)
    @name = name
    @price = price
    @warranty_months = warranty_months
  end

  def description -> String
    "Electronic: " + @name + " (" + @warranty_months.to_s + " months warranty)"
  end
end


book = Book.new("Design Patterns", 55.0, "Gang of Four")
laptop = Electronic.new("VoltBook Pro", 1499.99, 24)

puts(book.description)
puts(laptop.description)

tax_book = book.calculate_tax(0.2)
tax_laptop = laptop.calculate_tax(0.2)

puts("Book Tax: " + tax_book.to_s)
puts("Laptop Tax: " + tax_laptop.to_s)
