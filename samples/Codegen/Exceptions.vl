# Tier-1 exception transport, end to end: a raise several frames deep, a clause
# ladder picked by the ancestry walk, `ensure` on the handled and the untaken
# path alike, and a `begin` that raises nothing at all.
#
# It is also the regression test for the two defects that made every `raise`
# segfault: `Exception#initialize` runs `capture_backtrace`, which calls
# `String.from_c_string( p )` — a `Pointer<UInt8>` *parameter*, the shape the
# emitter used to bind as its own slot and therefore read through — and
# `ArgumentError` is a subclass, whose layout used to inherit none of
# `Exception`'s fields.
@[External( "libc", "exit" )]
external def libc_exit( value : Int32 ) -> Void

def deep -> Void
  raise ArgumentError.new( "from deep" )
end

def main -> Int32
  total = 0

  # Across a call frame, and matched by the second clause: the first must be
  # tried and rejected, and the body after the raise must not run.
  begin
    deep()
    total = total + 100
  rescue e : IndexError
    total = total + 200
  rescue e : ArgumentError
    total = total + 1
  ensure
    total = total + 2
  end

  # Matched through the ancestry chain rather than by exact type.
  begin
    raise KeyError.new( "sub" )
  rescue e : Exception
    total = total + 4
  end

  # Nothing in flight: no clause runs, `ensure` still does.
  begin
    total = total + 8
  rescue e : Exception
    total = total + 400
  ensure
    total = total + 16
  end

  total
end

libc_exit( main() )
