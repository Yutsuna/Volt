@[External( "libc", "memcpy" )]
external def libc_memcpy( dest : Pointer<Void>, src : Pointer<Void>, size : UInt64 ) -> Pointer<Void>

@[External( "libc", "memcmp" )]
external def libc_memcmp( a : Pointer<Void>, b : Pointer<Void>, size : UInt64 ) -> Int32

@[External( "libc", "strlen" )]
external def libc_strlen( str : Pointer<UInt8> ) -> UInt64


@[Literal( StringLiteral )]
struct String
  include Comparable
  include Hashable

  getter data  : Pointer<UInt8>
  getter size  : UInt64
  owns_buffer  : Bool

  def initialize( @data : Pointer<UInt8>, @size : UInt64, @owns_buffer : Bool = false )
  end

  def self.owned( data : Pointer<UInt8>, size : UInt64 ) -> String
    String.new( data, size, true )
  end

  def finalize -> Void
    @data.free if @owns_buffer
  end

  def self.from_c_string( ptr : Pointer<UInt8> ) -> String
    String.new( ptr, libc_strlen( ptr ) )
  end

  def dup -> String
    buf = Pointer<UInt8>.malloc( @size + 1_u64 )
    libc_memcpy( buf, @data, @size )
    *( buf + @size ) = 0_u8
    String.owned( buf, @size )
  end

  def empty? -> Bool
    @size == 0
  end

  def []( index : UInt64 ) -> UInt8
    *( @data + index )
  end

  def []=( index : UInt64, value : UInt8 ) -> Void
    *( @data + index ) = value
  end

  def <=>( other : String ) -> Int32
    min_size = @size < other.size ? @size : other.size
    cmp = libc_memcmp( @data, other.data, min_size )
    return cmp unless cmp == 0

    if @size < other.size
      -1
    elsif @size > other.size
      1
    else
      0
    end
  end

  def +( other : String ) -> String
    total = @size + other.size
    buf = Pointer<UInt8>.malloc( total + 1_u64 )
    libc_memcpy( buf, @data, @size )
    libc_memcpy( buf + @size, other.data, other.size )
    *( buf + total ) = 0_u8
    String.owned( buf, total )
  end

  def hash -> UInt64
    h = 5381
    i = 0_u64
    while i < @size
      h = ( ( h << 5 ) + h + *( @data + i ) ) & 72057594037927935
      i += 1
    end
    h
  end

  def to_string -> String
    self
  end

  def trim -> String
    start = 0_u64
    while start < @size
      b = *( @data + start )
      break unless b == 32_u8 or b == 9_u8 or b == 10_u8 or b == 13_u8
      start += 1
    end

    finish = @size
    while finish > start
      b = *( @data + ( finish - 1_u64 ) )
      break unless b == 32_u8 or b == 9_u8 or b == 10_u8 or b == 13_u8
      finish -= 1
    end

    len = finish - start
    buf = Pointer<UInt8>.malloc( len + 1_u64 )
    libc_memcpy( buf, @data + start, len )
    *( buf + len ) = 0_u8
    String.owned( buf, len )
  end

  def downcase -> String
    buf = Pointer<UInt8>.malloc( @size + 1_u64 )
    i = 0_u64
    while i < @size
      b = *( @data + i )
      if b >= 65_u8 and b <= 90_u8
        *( buf + i ) = b + 32_u8
      else
        *( buf + i ) = b
      end
      i += 1
    end
    *( buf + @size ) = 0_u8
    String.owned( buf, @size )
  end

  def upcase -> String
    buf = Pointer<UInt8>.malloc( @size + 1_u64 )
    i = 0_u64
    while i < @size
      b = *( @data + i )
      if b >= 97_u8 and b <= 122_u8
        *( buf + i ) = b - 32_u8
      else
        *( buf + i ) = b
      end
      i += 1
    end
    *( buf + @size ) = 0_u8
    String.owned( buf, @size )
  end

  def prefix( pre : String ) -> String
    pre + self
  end
end
