@[External("libc")]
def malloc( size : UInt64 ) -> Void*


x = 42_i64
ptr : Int64* = &x
if *ptr == 42_i64
  puts("PASS LOCAL ADDR")
else
  puts("FAIL LOCAL ADDR")
end


nil_ptr : Int64* = nil
if nil_ptr == nil
  puts("PASS NIL EQ")
else
  puts("FAIL NIL EQ")
end

if ptr != nil
  puts("PASS NONNIL NE")
else
  puts("FAIL NONNIL NE")
end


class Container
  value : Int64

  def initialize(@value : Int64)
  end

  def get_val_ptr -> Int64*
    &@value
  end
end

obj = Container.new(100_i64)
val_ptr = obj.get_val_ptr()
if *val_ptr == 100_i64
  puts("PASS CLASS IVAR ADDR")
else
  puts("FAIL CLASS IVAR ADDR")
end


struct Point
  x : Int64
  y : Int64
end

pt = Point.new(10_i64, 20_i64)
px : Int64* = &pt.x
if *px == 10_i64
  puts("PASS STRUCT FIELD ADDR")
else
  puts("FAIL STRUCT FIELD ADDR")
end


m_ptr : Int64* = malloc(8_u64)
*m_ptr = 0_i64
puts("PASS MALLOC WRITE " + (*m_ptr).to_string)

*m_ptr = 1_i64
puts("PASS MALLOC WRITE " + (*m_ptr).to_string)
