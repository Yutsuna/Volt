@[External("libc")]
def print(val : String) -> Void
end

@[External("libc")]
def puts(val : String) -> Void
end

macro log_info(expression)
  print("[INFO] ")
  print(__FILE__)
  print(" (ligne ")
  print(__LINE__)
  print(") : l'expression vaut ")
  puts({{expression}})
end

score = 42
log_info("score de l'utilisateur")

log_info("condition active")
