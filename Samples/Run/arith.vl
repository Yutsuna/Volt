@[External("libc")]
def puts( value ) -> Void

def fib( n : Int ) -> Int
  if n < 2
    return n
  end
  return fib( n - 1 ) + fib( n - 2 )
end

def sum_to( n : Int ) -> Int
  total = 0
  i = 0
  while i < n
    total = total + i
    i = i + 1
  end
  return total
end

puts( fib( 10 ) )
puts( sum_to( 10 ) )

radius = 2.0
area   = 3.14 * radius * radius
puts( area )

score = 7
if score > 8
  puts( "high" )
elsif score > 4 and score <= 8
  puts( "medium" )
else
  puts( "low" )
end
