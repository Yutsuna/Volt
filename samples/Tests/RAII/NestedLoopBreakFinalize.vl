def assert!( condition : Bool ) -> Void
  if not condition
    raise "Assertion failed #{__FILE__}:#{__LINE__}"
  end
end

#------------------------------------------------------------------------------

class Tracked
  id : Int32
  log : Pointer<Int32>
  cursor : Pointer<Int32>

  def initialize( @id : Int32, @log : Pointer<Int32>, @cursor : Pointer<Int32> ) end

  def finalize -> Void
    slot = *@cursor
    *( @log + slot ) = @id
    *@cursor = slot + 1
  end
end

def loop_and_break( log : Pointer<Int32>, cursor : Pointer<Int32> ) -> Void
  outer = Tracked.new( 9, log, cursor )
  i = 0
  while i < 5
    x = Tracked.new( i, log, cursor )
    if i == 2
      break
    end
    i = i + 1
  end
end

cursor = Pointer<Int32>.malloc( 1 )
*cursor = 0
log = Pointer<Int32>.malloc( 4 )

loop_and_break( log, cursor )

assert!( *cursor == 4 )
assert!( *( log + 0 ) == 0 )
assert!( *( log + 1 ) == 1 )
assert!( *( log + 2 ) == 2 )
assert!( *( log + 3 ) == 9 )

log.free
cursor.free
