class File
  include IO::Reader
  include IO::Writer
  include IO::Seekable

  getter fd        : Int32
  getter path      : String
  getter is_closed : Bool

  def initialize( @path : String, mode : String = "r" )
    flags = IO::OpenMode.flags_for( mode )
    perm = 420 # 0644 octal (rw-r--r--)
    @fd = LibC.open( @path.to_pointer(), flags, perm )
    if @fd < 0
      raise IO::IOError.new( "Cannot open file: " + @path )
    end
    @is_closed = false
  end

  def self.open( path : String, mode : String = "r" ) -> File
    File.new( path, mode )
  end

  def self.open( path : String, mode : String, &block : File -> Void ) -> Void
    file = File.new( path, mode )
    begin
      block.call( file )
    rescue e : Exception
      file.close()
      raise e
    end
    file.close()
  end

  def self.read_all( path : String ) -> String
    f = File.new( path, "r" )
    content = f.read_to_string()
    f.close()
    content
  end

  def self.write_all( path : String, content : String ) -> Void
    f = File.new( path, "w" )
    f.write_string( content )
    f.close()
  end

  def self.delete( path : String ) -> Bool
    LibC.unlink( path.to_pointer() ) == 0
  end

  def finalize -> Void
    close() unless @is_closed
  end

  def read( buffer : Pointer<Void>, count : UInt64 ) -> Int64
    raise IO::IOError.new( "File is closed" ) if @is_closed
    LibC.read( @fd, buffer, count )
  end

  def write( buffer : Pointer<Void>, count : UInt64 ) -> Int64
    raise IO::IOError.new( "File is closed" ) if @is_closed
    LibC.write( @fd, buffer, count )
  end

  def seek( offset : Int64, whence : Int32 = 0 ) -> Int64
    raise IO::IOError.new( "File is closed" ) if @is_closed
    LibC.lseek( @fd, offset, whence )
  end

  def tell -> Int64
    seek_from_current( 0 )
  end

  def flush -> Void
    LibC.fsync( @fd ) unless @is_closed
  end

  def close -> Void
    return if @is_closed
    LibC.close( @fd )
    @is_closed = true
  end
end
