struct Int include Inspectable

  #----------------------------------------------------------------------------

  def to_string -> String
    if self == 0
      return "0"
    end

    neg = self < 0
    n   = neg ? ( 0 - self ) : self

    count = 0
    tmp   = n
    while tmp > 0
      tmp   = tmp / 10
      count = count + 1
    end

    total        = neg ? count + 1 : count
    buf : UInt8* = malloc( total )

    idx = total - 1
    rem = n
    while rem > 0
      digit          = rem % 10
      *( buf + idx ) = 48_u8 + digit
      rem            = rem / 10
      idx            = idx - 1
    end
    *( buf + idx ) = 45_u8 if neg

    String.new( buf, total, true )
  end

  #----------------------------------------------------------------------------

end
