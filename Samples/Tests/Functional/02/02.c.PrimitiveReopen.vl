# Reopening a builtin primitive attaches pure-Volt methods to it: no
# NominalType, no layout — `self` is the 1-slot builtin value itself.
struct Int
  def double -> Int64
    self * 2
  end

  def clamp_positive -> Int64
    return 0 if self < 0
    self
  end
end

struct Bool
  def describe -> String
    return "yes" if self
    "no"
  end
end

x = 21
puts "double: #{x.double}"
puts "literal receiver: #{5.double}"
puts "negative: #{(0 - 7).clamp_positive}"
puts "chained: #{x.double.double}"
big   = x > 10
small = x > 100
puts big.describe
puts small.describe
