@[Literal( StringLiteral )]
struct String
  include Comparable
  include Hashable

  getter data  : Pointer<Char>
  getter size  : UInt64
  owns_buffer  : Bool

  def initialize( @data : Pointer<Char>, @size : UInt64, @owns_buffer : Bool = false )
  end

  def self.owned( data : Pointer<Char>, size : UInt64 ) -> String
    String.new( data, size, true )
  end

  def finalize -> Void
    @data.free if @owns_buffer
  end

  def self.from_c_string( ptr : Pointer<Char> ) -> String
    String.new( ptr, LibC.strlen( ptr ) )
  end

  def dup -> String
    buf = Pointer<Char>.malloc( @size + 1_u64 )
    LibC.memcpy( buf, @data, @size )
    *( buf + @size ) = '\0'
    String.owned( buf, @size )
  end

  def empty? -> Bool
    @size == 0
  end

  def []( index : UInt64 ) -> Char
    *( @data + index )
  end

  def []=( index : UInt64, value : Char ) -> Void
    *( @data + index ) = value
  end

  def <=>( other : String ) -> Int32
    min_size = @size < other.size ? @size : other.size
    cmp = LibC.memcmp( @data, other.data, min_size )
    return cmp unless cmp == 0

    if @size < other.size
      -1
    elsif @size > other.size
      1
    else
      0
    end
  end

  def +( other : String ) -> String
    total = @size + other.size
    buf = Pointer<Char>.malloc( total + 1_u64 )
    LibC.memcpy( buf, @data, @size )
    LibC.memcpy( buf + @size, other.data, other.size )
    *( buf + total ) = '\0'
    String.owned( buf, total )
  end

  def hash -> UInt64
    h = 5381
    i = 0_u64
    while i < @size
      h = ( ( h << 5 ) + h + *( @data + i ) ) & 72057594037927935
      i += 1
    end
    h
  end

  def to_string -> String
    self
  end

  def trim -> String
    start = 0_u64
    while start < @size
      b = *( @data + start )
      break unless b == ' ' or b == '\t' or b == '\n' or b == '\r'
      start += 1
    end

    finish = @size
    while finish > start
      b = *( @data + ( finish - 1_u64 ) )
      break unless b == ' ' or b == '\t' or b == '\n' or b == '\r'
      finish -= 1
    end

    len = finish - start
    buf = Pointer<Char>.malloc( len + 1_u64 )
    LibC.memcpy( buf, @data + start, len )
    *( buf + len ) = '\0'
    String.owned( buf, len )
  end

  def downcase -> String
    buf = Pointer<Char>.malloc( @size + 1_u64 )
    i = 0_u64
    while i < @size
      b = *( @data + i )
      if b >= 'A' and b <= 'Z'
        *( buf + i ) = b + 32_u8
      else
        *( buf + i ) = b
      end
      i += 1
    end
    *( buf + @size ) = '\0'
    String.owned( buf, @size )
  end

  def upcase -> String
    buf = Pointer<Char>.malloc( @size + 1_u64 )
    i = 0_u64
    while i < @size
      b = *( @data + i )
      if b >= 'a' and b <= 'z'
        *( buf + i ) = b - 32_u8
      else
        *( buf + i ) = b
      end
      i += 1
    end
    *( buf + @size ) = '\0'
    String.owned( buf, @size )
  end

  def prefix( pre : String ) -> String
    pre + self
  end
end
