#{
  @brief Executes top-level initialization statements for all compilation units in order.
  @details Bound to the backend-generated symbol `_V_init_all`.
#}
@[External( "volt", "_V_init_all" )]
external def __volt_run_units -> Void

#{
  @brief Tears down module-level static variables in reverse initialization order.
  @details Bound to the backend-generated symbol `_V_fini_all`.
#}
@[External( "volt", "_V_fini_all" )]
external def __volt_release_units -> Void

#{
  @brief Runtime entry point invoked by the C `main` wrapper.
  @return Process exit status (`0` on success, `1` on uncaught exception).
#}
def __volt_entry -> Int32
  begin
    __volt_run_units()
    0
  rescue e : Exception
    e.report_unhandled()
    1
  ensure
    # Guarantee unit teardown even on uncaught exceptions.
    __volt_release_units()
  end
end
