def test_bitwise_and -> Void
  a = 0b1100
  b = 0b1010
  assert!( ( a & b ) == 0b1000 )

  c = 0xFF
  c &= 0x0F
  assert!( c == 0x0F )
end

def test_bitwise_or -> Void
  a = 0b1100
  b = 0b1010
  assert!( ( a | b ) == 0b1110 )

  c = 0xF0
  c |= 0x0F
  assert!( c == 0xFF )
end

def test_bitwise_xor -> Void
  a = 0b1100
  b = 0b1010
  assert!( ( a ^ b ) == 0b0110 )

  c = 0xAA
  c ^= 0xFF
  assert!( c == 0x55 )
end

def test_bitwise_shift_left -> Void
  a = 1
  assert!( ( a << 3 ) == 8 )

  c = 2
  c <<= 4
  assert!( c == 32 )
end

def test_bitwise_shift_right -> Void
  a = 32
  assert!( ( a >> 3 ) == 4 )

  c = 64
  c >>= 2
  assert!( c == 16 )

  # Logical shift on unsigned
  u = 0x80000000.to_u32
  assert!( ( u >> 1 ) == 0x40000000.to_u32 )

  # Arithmetic shift on signed
  s = -8
  assert!( ( s >> 1 ) == -4 )
end

def test_bitwise_not -> Void
  a = 0.to_u8
  assert!( ( ~a ) == 255.to_u8 )

  b = 0
  assert!( ( ~b ) == -1 )
end

def test_different_widths -> Void
  u8_val = 0b00001111.to_u8
  assert!( ( u8_val & 0b00000101.to_u8 ) == 0b00000101.to_u8 )
  assert!( ( u8_val | 0b11110000.to_u8 ) == 255.to_u8 )
  assert!( ( u8_val ^ 0b00001111.to_u8 ) == 0.to_u8 )
  assert!( ( u8_val << 2.to_u8 ) == 0b00111100.to_u8 )

  u64_val = 0x12345678.to_u64
  assert!( ( u64_val >> 16.to_u64 ) == 0x1234.to_u64 )
  assert!( ( u64_val << 8.to_u64 ) == ( u64_val * 256.to_u64 ) )
end

test_bitwise_and()
test_bitwise_or()
test_bitwise_xor()
test_bitwise_shift_left()
test_bitwise_shift_right()
test_bitwise_not()
test_different_widths()
