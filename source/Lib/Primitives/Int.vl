@[Primitive( "i8", 8 )]
struct Int8
  include Comparable
  include Hashable
  include Arithmetic
  include Stringable

  def <=>( other : Int8 ) -> Int32
    if self < other
      -1
    elsif self > other
      1
    else
      0
    end
  end

  def hash -> UInt64
    self
  end
end


@[Primitive( "i16", 16 )]
struct Int16
  include Comparable
  include Hashable
  include Arithmetic
  include Stringable

  def <=>( other : Int16 ) -> Int32
    if self < other
      -1
    elsif self > other
      1
    else
      0
    end
  end

  def hash -> UInt64
    self
  end
end


@[Primitive( "i32", 32 ), Literal( IntLiteral )]
struct Int32
  include Comparable
  include Hashable
  include Arithmetic
  include Stringable

  def <=>( other : Int32 ) -> Int32
    if self < other
      -1
    elsif self > other
      1
    else
      0
    end
  end

  def hash -> UInt64
    h = self
    h ^= ( h << 13 )
    h ^= ( h >> 7 )
    h ^ ( h << 17 )
  end
end


@[Primitive( "i64", 64 )]
struct Int64
  include Comparable
  include Hashable
  include Arithmetic
  include Stringable

  def <=>( other : Int64 ) -> Int32
    if self < other
      -1
    elsif self > other
      1
    else
      0
    end
  end

  def hash -> UInt64
    h = self
    h ^= ( h << 13 )
    h ^= ( h >> 7 )
    h ^ ( h << 17 )
  end

end
