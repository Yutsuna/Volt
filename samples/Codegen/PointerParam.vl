# A `Pointer<T>` parameter is a *scalar*, and the emitter must bind it like
# one. `@[Primitive( "ptr", 64 )]` maps to LLVM `ptr`, so an emitter that asks
# "is the argument's LLVM type a pointer?" instead of "is its layout an
# aggregate?" concludes the argument is already its own slot, and every read of
# the name then loads *through* it. Passing `nil` makes that deterministic: the
# buggy shape is `load ptr, ptr null`.
@[External( "libc", "exit" )]
external def libc_exit( value : Int32 ) -> Void

def is_nil( p : Pointer<Int32> ) -> Bool
  p == nil
end

def main -> Int32
  is_nil( nil ) ? 9 : 0
end

libc_exit( main() )
