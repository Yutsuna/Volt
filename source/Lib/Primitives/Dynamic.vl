# Dynamic.vl — The type of dynamic polymorphic fat pointers.
#
# A dynamic fat pointer is a pair of:
#   - data: raw pointer to the concrete instance
#   - vtable: raw pointer to the static VTable constant array
#
# Borrowed dynamic fat pointers (Dynamic<T>) do not own the underlying memory.

@[Literal( DynamicType )]
struct Dynamic<T>

  data : Pointer<UInt8>
  vtable : Pointer<Pointer<UInt8>>

  def initialize( @data : Pointer<UInt8>, @vtable : Pointer<Pointer<UInt8>> )
  end

  def to_string -> String
    "Dynamic(#{@data}, #{@vtable})"
  end

end
