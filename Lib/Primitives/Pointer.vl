@[External("libc", "calloc")]
def __volt_calloc( count : UInt64, size : UInt64 ) -> Void*

@[External("libc", "realloc")]
def __volt_realloc( ptr : Void*, size : UInt64 ) -> Void*

@[External("libc", "free")]
def __volt_free( ptr : Void* ) -> Void

@[External]
def __volt_ptr_address( ptr : Void* ) -> UInt64


struct Pointer[ T ] include Inspectable

  def null? -> Bool
    address == 0
  end

  def address -> UInt64
    __volt_ptr_address self
  end

  def value -> T
    *self
  end

  def self.malloc( size : UInt64 ) -> Pointer[ T ]
    __volt_calloc( size, sizeof T )
  end

  def realloc(size : UInt64) -> Pointer[ T ]
    __volt_realloc( self, size * sizeof T )
  end

  def free -> Void
    __volt_free self
  end

  def to_string -> String
    "0x#{address.to_string}"
  end

end
