# Loops, compound assignment and a free function call, all in one exit code.
@[External( "libc", "exit" )]
external def libc_exit( value : Int32 ) -> Void

def add( a : Int32, b : Int32 ) -> Int32
  a + b
end

def main -> Int32
  total = 0
  i = 1
  while i <= 10
    total += i
    i += 1
  end
  add( total, 2 ) - 50
end

libc_exit( main() )
