@[Primitive( "u8", 8 ), Literal( CharLiteral )]
struct Char
  include Comparable
  include Hashable
  include Arithmetic

  #----------------------------------------------------------------------------

  def <=>( other : Char ) -> Int32
    if self < other
      -1
    elsif self > other
      1
    else
      0
    end
  end

  #----------------------------------------------------------------------------

  def hash -> UInt64
    self
  end

  def digit? -> Bool
    self >= '0' and self <= '9'
  end

  def lowercase? -> Bool
    self >= 'a' and self <= 'z'
  end

  def uppercase? -> Bool
    self >= 'A' and self <= 'Z'
  end

  def alpha? -> Bool
    self.lowercase? or self.uppercase?
  end

  def alphanumeric? -> Bool
    self.alpha? or self.digit?
  end

  def hex_digit? -> Bool
    self.digit? or ( self >= 'a' and self <= 'f' ) or ( self >= 'A' and self <= 'F' )
  end

  def binary_digit? -> Bool
    self == '0' or self == '1'
  end

  def octal_digit? -> Bool
    self >= '0' and self <= '7'
  end

  def whitespace? -> Bool
    self == ' ' or ( self >= '\t' and self <= '\r' )
  end

  def ascii? -> Bool
    self <= '\x7F'
  end

  def printable? -> Bool
    self >= ' ' and self <= '~'
  end

  def control? -> Bool
    self < ' ' or self == '\x7F'
  end

  def downcase -> Char
    if self.uppercase? then self + 32_u8 else self end
  end

  def upcase -> Char
    if self.lowercase? then self - 32_u8 else self end
  end

  #----------------------------------------------------------------------------

  def to_digit( radix : Int32 = 10 ) -> Int32
    val = -1
    case self
    when .digit?      then val = self - '0'
    when .lowercase?  then val = self - 'a' + 10
    when .uppercase?  then val = self - 'A' + 10
    else ( val >= 0 and val < radix ) ? val : -1
    end
  end

  #----------------------------------------------------------------------------

  def to_string -> String
    buf = Pointer<Char>.malloc( 2_u64 )
    *( buf ) = self
    *( buf + 1_u64 ) = '\0'
    String.new( buf, 1_u64, true )
  end

  def inspect -> String
    case self
    when '\0' then "'\\0'"
    when '\a' then "'\\a'"
    when '\b' then "'\\b'"
    when '\t' then "'\\t'"
    when '\n' then "'\\n'"
    when '\v' then "'\\v'"
    when '\f' then "'\\f'"
    when '\r' then "'\\r'"
    when '\\' then "'\\\\'"
    when '\'' then "'\\''"
    else           to_string
    end
  end

#----------------------------------------------------------------------------

end
