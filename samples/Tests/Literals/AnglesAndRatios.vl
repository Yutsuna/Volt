def test_percentages -> Void
  assert!( 0% == 0.0 )
  assert!( 50% == 0.5 )
  assert!( 80% == 0.8 )
  assert!( 100% == 1.0 )
  assert!( 150% == 1.5 )
end

def test_angles_in_radians -> Void
  assert!( 0rad == 0.0 )
  assert!( 1rad == 1.0 )
  assert!( 0deg == 0.0 )
  assert!( 0turn == 0.0 )
  assert!( 0.25turn == 90deg )
  assert!( 0.5turn == 180deg )
  assert!( 1turn == 360deg )
  assert!( 2turn == 720deg )
end

def main -> Int32
  test_percentages
  test_angles_in_radians
  0
end

main
