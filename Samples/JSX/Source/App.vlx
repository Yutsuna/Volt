component App

  state = { count : Int = 0, user : User? = nil }

  def increment
    state.count += 1
  end

  def login
    state.user = User.new( name: "Léo", email: "leo.beaugose.fr", admin: false )
  end

   <div class="app">
    <Header title="Volt Demo" />
    <Counter count={state.count} on_increment={-> increment} />
    {state.user ? <UserProfile user={state.user} /> : <button on:click={-> login}>Login</button>}
  </div>

end
