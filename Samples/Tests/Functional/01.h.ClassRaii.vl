@[External("libc")]
def puts( str : String ) -> Int32
end

class DatabaseConnection
  id : Int64

  def initialize(id : Int64)
    @id = id
    puts("CONNECTED DB " + @id.to_s)
  end

  def finalize
    puts("DISCONNECTED DB " + @id.to_s)
  end
end

class SessionManager
  db : DatabaseConnection

  def initialize(db_id : Int64)
    @db = DatabaseConnection.new(db_id)
    puts("INIT SESSION_MANAGER")
  end

  def finalize
    puts("FINALIZE SESSION_MANAGER")
  end
end

def execute_request -> Void
  puts("ENTERING SCOPE")
  manager = SessionManager.new(101)
  puts("LEAVING SCOPE")
end

execute_request
puts("TEST COMPLETE")
