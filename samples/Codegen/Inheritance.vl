# A subclass's storage *is* one of its base: `super( a, b )` hands `self`
# straight to `Base#initialize`, which GEPs `@a` at the offset *Base*'s layout
# gives it. So the base's fields must lead the subclass's own, spliced flat —
# `TypeBinder` used to lay a subclass out from its own body alone, making
# `Derived` a zero-field aggregate that `Base#initialize` then wrote past.
@[External( "libc", "exit" )]
external def libc_exit( value : Int32 ) -> Void

class Base
  getter a : Int32
  getter b : Int32

  def initialize( @a : Int32, @b : Int32 )
  end

  def sum -> Int32
    @a + @b
  end
end

class Derived < Base
  getter c : Int32

  def initialize( a : Int32, b : Int32, @c : Int32 )
    super( a, b )
  end

  # Reaches an inherited method, which reads inherited fields through a
  # `Derived` receiver.
  def total -> Int32
    sum() + @c
  end
end

def main -> Int32
  d = Derived.new( 3, 4, 5 )
  d.total() + d.a
end

libc_exit( main() )
