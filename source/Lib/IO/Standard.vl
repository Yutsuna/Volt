module IO


  class StandardStream
    include Reader
    include Writer
    include Inspectable

    getter fd : Int32

    def initialize( @fd : Int32 )
    end

    def read( buffer : Pointer<Void>, count : UInt64 ) -> Int64
      LibC.read( @fd, buffer, count )
    end

    def write( buffer : Pointer<Void>, count : UInt64 ) -> Int64
      LibC.write( @fd, buffer, count )
    end

    def flush -> Void
      LibC.fsync( @fd )
    end

  end

  def self.stdin -> StandardStream
    StandardStream.new( 0 )
  end

  def self.stdout -> StandardStream
    StandardStream.new( 1 )
  end

  def self.stderr -> StandardStream
    StandardStream.new( 2 )
  end

end
