mixin Numeric
  include Comparable
  include Arithmetic

  #----------------------------------------------------------------------------

  abstract def +( other : self ) -> self
  abstract def -( other : self ) -> self
  abstract def *( other : self ) -> self
  abstract def /( other : self ) -> self

  #----------------------------------------------------------------------------

  abstract def to_i8   -> Int8
  abstract def to_i16  -> Int16
  abstract def to_i32  -> Int32
  abstract def to_i64  -> Int64
  abstract def to_u8   -> UInt8
  abstract def to_u16  -> UInt16
  abstract def to_u32  -> UInt32
  abstract def to_u64  -> UInt64
  abstract def to_f32  -> Float32
  abstract def to_f64  -> Float64
  abstract def to_char -> Char

  #----------------------------------------------------------------------------

  def step( to : self, by : self = 1, &block : self -> Void ) -> Void
    current = self
    if by > 0
      while current <= to
        block.call( current )
        return if current == to
        current += by
      end
    elsif by < 0
      while current >= to
        block.call( current )
        return if current == to
        current += by
      end
    end
  end

  def upto( limit : self, &block : self -> Void ) -> Void
    step( limit, 1, &block )
  end

  def downto( limit : self, &block : self -> Void ) -> Void
    step( limit, -1, &block )
  end

  def times( &block : self -> Void ) -> Void
    return if self <= 0
    ( self - self ).step( self - 1, 1, &block )
  end

  #----------------------------------------------------------------------------

  def zero? -> Bool
    self == 0
  end

  def negative? -> Bool
    self < 0
  end

  def to_hex -> String
    return "0x0" if self.zero?

    is_neg = self.negative?
    value  = is_neg ? ( 0 - self ) : self
    result = ""

    while value > 0
      nibble = ( value & 0xF ).to_u8
      ch = nibble < 10_u8 ? ( '0'.to_u8 + nibble ).to_char : ( 'A'.to_u8 + ( nibble - 10_u8 ) ).to_char
      result = "#{ch}#{result}"
      value >>= 4
    end

    is_neg ? "-0x#{result}" : "0x#{result}"
  end

  #----------------------------------------------------------------------------

end
