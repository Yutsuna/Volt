@[External]
def __volt_format_float( value : Float64, buf : UInt8* ) -> Int32


struct Float include Inspectable

  #----------------------------------------------------------------------------

  # `snprintf` is variadic (`int snprintf(char *s, size_t n, const char *fmt, ...)`)
  # and Volt's FFI has no variadic support — `__volt_format_float` is a
  # dedicated, non-variadic native helper for exactly this conversion.
  # Hand-rolling float formatting (fractional digits, rounding) in pure
  # Volt would need a Float -> Int truncation primitive Volt doesn't have
  # yet ; that's real future work, not this one.
  def to_string -> String
    return "0.0" if self == 0
    buf    = Pointer[ UInt8 ].malloc( 32 )
    digits = __volt_format_float( self, buf )
    String.new( buf, digits, true )
  end

  #----------------------------------------------------------------------------

end
