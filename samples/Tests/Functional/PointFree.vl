calc_pointed = ( x : Int32 ) => { ( x + 10 ) * 2 }
calc_pointfree = ( &.+ 10 ) >> ( &.* 2 )
assert!( calc_pointed( 2 ) == 24 )
assert!( calc_pointfree( 2 ) == 24 )
assert!( 2 |> calc_pointfree == 24 )


clean_pointed = ( s : String ) => { s.trim.downcase.prefix("[user]: ") }
clean_pointfree = (&.trim)
               >> (&.downcase)
               >> (&.prefix("[user]: "))

assert!( clean_pointfree("  ALICE ") == "[user]: alice" )
assert!( "  BOB " |> clean_pointfree == "[user]: bob" )


numbers = [ 1, 2, 3, 4, 5 ]
results = numbers.map( ( &.+ 10 ) >> ( &.* 2 ) )

assert!( results[0] == 22 )
assert!( results[1] == 24 )
assert!( results[2] == 26 )


transform = ( &.trim ) >> ( &.prefix( "usr_" ) )
raw_users = [ " alice ", " bob " , "    " ]
clean_users = raw_users
  .filter( (&.empty?.!) )
  .map( &transform )
assert!( clean_users[0] == "usr_alice" )
assert!( clean_users[1] == "usr_bob" )


no_type_pointfree = ( &.to_string ) >> ( &.prefix( "Value: " ) )
assert!( no_type_pointfree( 42 ) == "Value: 42" )
assert!( no_type_pointfree( 3.14 ) == "Value: 3.140000" )
assert!( no_type_pointfree( true ) == "Value: true" )
assert!( no_type_pointfree( [1, 2, 3] ) == "Value: [1, 2, 3]" )
assert!( no_type_pointfree( "Volt" ) == "Value: Volt" )

class Item
  name : String
  score : Int32

  def initialize( name : String, score : Int32 )
    @name = name
    @score = score
  end

  def formatted_score -> String
    @score.to_string.prefix( "Score: " )
  end
end

item = Item.new( "Potion", 100 )
get_item_score = (&.formatted_score) >> (&.prefix( "[Item] " ))
assert!( get_item_score( item ) == "[Item] Score: 100" )
assert!( item |> get_item_score == "[Item] Score: 100" )

