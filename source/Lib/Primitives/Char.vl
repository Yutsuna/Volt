@[Primitive( "u8", 8 ), Literal( CharLiteral )]
struct Char
  include Comparable
  include Hashable
  include Arithmetic

  def <=>( other : Char ) -> Int32
    if self < other
      -1
    elsif self > other
      1
    else
      0
    end
  end

  def hash -> UInt64
    self
  end

  # One byte, not a decimal rendering: `"#{ 'A' }"` must read "A", not "65".
  # Char therefore cannot `include Stringable` — its digits are not its value.
  def to_string -> String
    buf = Pointer<Char>.malloc( 2_u64 )
    *( buf ) = self
    *( buf + 1_u64 ) = '\0'
    String.new( buf, 1_u64, true )
  end
end
