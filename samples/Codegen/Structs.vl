# A user struct: field storage, an initializer reached through `.new`, and
# instance methods on an aggregate receiver.
struct Point
  getter x : Int32
  getter y : Int32

  def initialize( @x : Int32, @y : Int32 )
  end

  def sum -> Int32
    @x + @y
  end

  def shifted( delta : Int32 ) -> Int32
    @x + @y + delta
  end
end

def main -> Int32
  p = Point.new( 3, 4 )
  p.sum + p.shifted( 5 )
end
