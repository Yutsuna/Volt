def increment(x : Int32) -> Int32
  x + 1
end

def multiply(x : Int32, factor : Int32) -> Int32
  x * factor
end

def clamp(x : Int32, min : Int32, max : Int32) -> Int32
  return min if x < min
  return max if x > max
  x
end


module FormatUtils


  def self.wrap_in_brackets( text : String ) -> String
    "[" + text + "]"
  end

  def self.prepend_status( text : String, status : String ) -> String
    status + " " + text
  end


end


# clamp(multiply(increment(5), 3), 0, 15)
raw_result = 5
  |> increment
  |> multiply 3
  |> clamp( 0, 15 )


# final_report = FormatUtils.prepend_status(FormatUtils.wrap_in_brackets(raw_result.to_string),"SUCCESS :")
final_report = raw_result.to_string
  |> FormatUtils.wrap_in_brackets
  |> FormatUtils.prepend_status "SUCCESS :"


puts final_report
