def test_uint8 -> Void
  a : UInt8 = 200
  b : UInt8 = 50
  zero : UInt8 = 0

  assert!( a + b == 250 )
  assert!( a - b == 150 )
  assert!( a / b == 4 )
  assert!( a % b == 0 )
  assert!( a.min( b ) == 50 )
  assert!( a.max( b ) == 200 )
  assert!( a.successor == 201 )
  assert!( a.predecessor == 199 )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( a.even? )
  assert!( ( 128 : UInt8 ).power_of_two? )
  assert!( a.divisible_by?( b ) )
  assert!( a.distance( b ) == 150 )
  assert!( b.double == 100 )
  assert!( a.half == 100 )
end

def test_uint16 -> Void
  a : UInt16 = 40000
  b : UInt16 = 10000
  zero : UInt16 = 0

  assert!( a + b == 50000 )
  assert!( a - b == 30000 )
  assert!( a / b == 4 )
  assert!( a.successor == 40001 )
  assert!( a.predecessor == 39999 )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( a.even? )
  assert!( ( 32768 : UInt16 ).power_of_two? )
  assert!( a.divisible_by?( b ) )
  assert!( a.distance( b ) == 30000 )
  assert!( b.double == 20000 )
  assert!( a.half == 20000 )
end

def test_uint32 -> Void
  a : UInt32 = 3000000000
  b : UInt32 = 1000000000
  zero : UInt32 = 0

  assert!( a + b == 4000000000 )
  assert!( a - b == 2000000000 )
  assert!( a / b == 3 )
  assert!( a.successor == 3000000001 )
  assert!( a.predecessor == 2999999999 )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( a.even? )
  assert!( a.divisible_by?( b ) )
  assert!( a.distance( b ) == 2000000000 )
  assert!( b.double == 2000000000 )
  assert!( a.half == 1500000000 )
end

def test_uint64 -> Void
  a : UInt64 = 1000000000000
  b : UInt64 = 500000000000
  zero : UInt64 = 0

  assert!( a + b == 1500000000000 )
  assert!( a - b == 500000000000 )
  assert!( a / b == 2 )
  assert!( a.successor == 1000000000001 )
  assert!( a.predecessor == 999999999999 )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( a.even? )
  assert!( a.divisible_by?( b ) )
  assert!( a.distance( b ) == 500000000000 )
  assert!( b.double == 1000000000000 )
  assert!( a.half == 500000000000 )
end


#------------------------------------------------------------------------------


def test_float32 -> Void
  a : Float32 = 10.0
  b : Float32 = 2.5
  neg : Float32 = -5.0
  zero : Float32 = 0.0

  assert!( a + b == 12.5 )
  assert!( a - b == 7.5 )
  assert!( a * b == 25.0 )
  assert!( a / b == 4.0 )
  assert!( neg.abs == 5.0 )
  assert!( neg.negate == 5.0 )
  assert!( a.min( b ) == 2.5 )
  assert!( a.max( b ) == 10.0 )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( neg.negative? )
  assert!( b.square == 6.25 )
  assert!( b.double == 5.0 )
  assert!( a.half == 5.0 )
  assert!( a.distance( b ) == 7.5 )
  assert!( a.clamp( 0.0, 5.0 ) == 5.0 )
end

def test_float64 -> Void
  a : Float64 = 100.0
  b : Float64 = 25.0
  neg : Float64 = -50.0
  zero : Float64 = 0.0

  assert!( a + b == 125.0 )
  assert!( a - b == 75.0 )
  assert!( a * b == 2500.0 )
  assert!( a / b == 4.0 )
  assert!( neg.abs == 50.0 )
  assert!( neg.negate == 50.0 )
  assert!( a.min( b ) == 25.0 )
  assert!( a.max( b ) == 100.0 )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( neg.negative? )
  assert!( b.square == 625.0 )
  assert!( b.double == 50.0 )
  assert!( a.half == 50.0 )
  assert!( ( 3.0 : Float64 ).cube == 27.0 )
  assert!( a.distance( b ) == 75.0 )
  assert!( a.clamp( 0.0, 50.0 ) == 50.0 )
end


#------------------------------------------------------------------------------


def main -> Int32
  test_int8
  test_int16
  test_int32
  test_int64

  test_uint8
  test_uint16
  test_uint32
  test_uint64

  test_float32
  test_float64
  0
end

libc_exit( main() )
