def assert!( condition : Bool ) -> Void
  if not condition
    raise "Assertion failed #{__FILE__}:#{__LINE__}"
  end
end

#------------------------------------------------------------------------------

struct Plain
  getter tag : Int32

  def initialize( @tag : Int32 )
  end
end

def use_plain -> Int32
  p = Plain.new( 42 )
  p.tag
end

assert!( use_plain == 42 )
