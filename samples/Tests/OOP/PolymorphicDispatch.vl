def assert!( condition : Bool ) -> Void
  if not condition
    raise "Assertion failed #{__FILE__}:#{__LINE__}"
  end
end


mixin Shape

  abstract def name -> String
  abstract def area -> Int32

  def describe -> String
    "#{self.name} with area #{area}"
  end

end


class Rectangle
  include Shape

  getter name : String
  getter width : Int32
  getter height : Int32

  def initialize( @name : String, @width : Int32, @height : Int32 )
  end

  def area -> Int32
    @width * @height
  end

end


class Square < Rectangle

  def initialize( size : Int32 )
    super( "Square", size, size )
  end

end


class Circle
  include Shape

  getter name : String
  getter radius : Int32

  def initialize( @radius : Int32 )
    @name = "Circle"
  end

  def area -> Int32
    3 * @radius * @radius
  end

end


r = Rectangle.new( "Rect", 4, 5 )
s = Square.new( 3 )
c = Circle.new( 2 )

assert!( r.describe == "Rect with area 20" )
assert!( s.describe == "Square with area 9" )
assert!( c.describe == "Circle with area 12" )

assert!( r.area + s.area + c.area == 41 )

