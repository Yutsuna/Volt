# The type of anything callable: a written signature `( A, B ) -> R`, a lambda
# `( x ) => x`, and a trailing `do | x | ... end` block all denote the same
# thing, so one type claims the three node kinds.
#
# Arguments are the parameters followed by the return type — `Proc<Int32, Bool>`
# is a function of one Int32 returning a Bool — which is exactly the order the
# FuncType node reflects its fields in, so the binding needs no @[Literal] slots.

@[Literal( FuncType ), Literal( Lambda ), Literal( Block )]
struct Proc<R>

  # The callable value itself: an address to enter, and the environment to
  # enter it with. Declared as ordinary fields — not a backend-synthesized
  # shape — so `InstanceLayouts::Of` needs no `IsCallable` special case: the
  # same field-flattening every other struct gets already produces the
  # `{ ptr, ptr }` layout .agents/backend/abi.md fixes. An empty environment
  # is a null `Pointer<UInt8>`, never a missing field.
  code : Pointer<UInt8>
  env : Pointer<UInt8>

  def initialize( code : Pointer<UInt8>, env : Pointer<UInt8> )
    @code = code
    @env = env
  end

  # The one contract of a callable. It is `abstract` for the same reason
  # `Int32#+` is: the target supplies the operation. `+` on a primitive layout
  # is a machine instruction; `call` on the type claiming FuncType is an
  # indirect call through the `{ code, env }` pair — both decided by what the
  # receiver *is*, never by an annotation naming this line.
  #
  # It takes no parameters here because it cannot: a Proc's arity lives in its
  # type arguments (`Proc<R, A, B>`), which is why the resolution reads the
  # signature off the receiver rather than off this declaration.
  abstract def call -> R

  def finalize -> Void
    @env.free if @env.to_address != 0_u64
  end

  def to_string -> String
    "Proc(#{@code}, #{@env})"
  end

end
