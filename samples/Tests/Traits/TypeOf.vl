count : Int32 = 41
mirrored : typeof( count ) = 1
assert!( count + mirrored == 42 )

label : String = "volt"
echoed : typeof( label ) = "volt"
assert!( echoed == label )

doubled : typeof( count * 2 ) = 84
assert!( doubled == count * 2 + 2 )

numbers = Array<typeof( count )>.new
numbers.push( count )
numbers.push( mirrored )
assert!( numbers.size == 2 )
assert!( numbers[0] == 41 )

assert!( sizeof( typeof( count ) ) == sizeof( Int32 ) )

# Expression-position typeof
t_int = typeof count
t_str = typeof label
assert!( t_int.name == "Int32" )
assert!( t_str.name == "String" )
assert!( t_int.to_string == "Int32" )
assert!( t_int == typeof( mirrored ) )
assert!( t_int != t_str )
assert!( typeof( t_int ).name == "Type" )

