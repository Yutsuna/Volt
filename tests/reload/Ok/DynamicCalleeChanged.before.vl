# A `dyn Trait` call reads its callee out of a vtable rather than through
# `@volt.fn.<sym>`, so repointing the slot alone leaves it running the old body.
mixin Shape
  abstract def area -> Int32
end

class Rectangle
  include Shape

  def initialize
  end

  def area -> Int32
    3
  end
end

def __volt_entry -> Int32
  r = Rectangle.new
  d : Dynamic<Shape> = r
  d.area
end
