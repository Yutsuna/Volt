module IO


  mixin Writer
    abstract def write( buffer : Pointer<Void>, count : UInt64 ) -> Int64

    def flush -> Void
    end

    def write_byte( byte : UInt8 ) -> Void
      buf = Pointer<UInt8>.malloc( 1_u64 )
      *( buf ) = byte
      write( buf, 1_u64 )
      buf.free
    end

    def write_string( str : String ) -> Int64
      return 0 if str.size == 0
      write( str.to_pointer(), str.size )
    end

    def print( str : String ) -> self
      write_string( str )
      self
    end

    def puts( str : String ) -> self
      write_string( str )
      write_string( "\n" )
      self
    end

    def putc( byte : UInt8 ) -> self
      write_byte( byte )
      self
    end

    def <<( str : String ) -> self
      print( str )
    end
  end


end
