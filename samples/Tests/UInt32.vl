@[External( "libc", "exit" )]
external def libc_exit( value : Int32 ) -> Void

# The oracle is the exit code, and it has to be one the runtime cannot fake.
# `raise` cannot be used here: with no enclosing `begin`, tier-1 EH unwinds by
# returning early carrying no value, which for an Int32 body is `ret i32 0` —
# indistinguishable from success by the time `libc_exit( main() )` reads it.
# A failed assertion would exit 0 and the whole corpus would assert nothing.
def assert!( condition : Bool ) -> Void
  if not condition
    libc_exit( 1 )
  end
end

#------------------------------------------------------------------------------

def test_uint32 -> Void
  a : UInt32 = 3000000000
  b : UInt32 = 1000000000
  zero : UInt32 = 0

  assert!( a + b == 4000000000 )
  assert!( a - b == 2000000000 )
  assert!( a / b == 3 )
  assert!( a.successor == 3000000001 )
  assert!( a.predecessor == 2999999999 )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( a.even? )
  assert!( a.divisible_by?( b ) )
  assert!( a.distance( b ) == 2000000000 )
  assert!( b.double == 2000000000 )
  assert!( a.half == 1500000000 )
end

#------------------------------------------------------------------------------

def main -> Int32
  test_uint32
  0
end

libc_exit( main() )
