@[Primitive( "ptr", 64 ), Literal( PointerType )]
struct Pointer<T>
  include Comparable

  abstract def +( offset : UInt64 ) -> Pointer<T>
  abstract def -( offset : UInt64 ) -> Pointer<T>

  def ++ -> Pointer<T>
    self + 1_u64
  end

  def -- -> Pointer<T>
    self - 1_u64
  end

  abstract def to_address() -> UInt64
  abstract def self.from_address( address : UInt64 ) -> Pointer<T>

  def self.malloc( count : UInt64 ) -> Pointer<T>
    LibC.malloc( count * sizeof T )
  end

  def free -> Void
    LibC.free( self )
  end

  def <=>( other : Pointer<T> ) -> Int32
    if self < other
      -1
    elsif self > other
      1
    else
      0
    end
  end

  def to_string -> String
    "Pointer<T>@#{self.to_address().to_hex()}"
  end

  def inspect -> String
    to_string
  end

end
