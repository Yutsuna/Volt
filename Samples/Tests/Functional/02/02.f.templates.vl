macro assert( condition )
  if {{ condition }}
    puts "PASS"
  else
    raise "FAIL"
  end
end


class FBox[ T ]

  value : T

  def initialize( @value : T )
  end

  def get_value -> T
    @value
  end

end


struct FPair[ T, U ]

  first : T
  second : U

  def initialize( @first : T, @second : U )
  end

  def get_first -> T
    @first
  end

  def get_second -> U
    @second
  end

end


int_box = FBox[ Int32 ].new( 100 )
assert(int_box.get_value() == 100)

str_box = FBox[ String ].new( "Volt" )
assert(str_box.get_value() == "Volt")

nested_box = FBox[ FBox [ Int32 ] ].new( int_box )
assert( nested_box.get_value().get_value() == 100 )

pair = FPair[ String , Int32 ].new( "Version", 42 )
assert( pair.get_first() == "Version" )
assert( pair.get_second() == 42 )

inferred_box = FBox.new( 999 )
assert( inferred_box.get_value() == 999 )
