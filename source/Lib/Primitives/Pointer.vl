@[External( "libc" )]
external def malloc( size : UInt64 ) -> Pointer<Void>

@[External( "libc" )]
external def free( ptr : Pointer<Void> ) -> Void


@[Primitive( "ptr", 64 ), Literal( PointerType )]
struct Pointer<T>
  include Comparable

  def self.malloc( count : UInt64 ) -> Pointer<T>
    malloc( count * sizeof T )
  end

  def free -> Void
    free( self )
  end

  def <=>( other : Pointer<T> ) -> Int32
    if self < other
      -1
    elsif self > other
      1
    else
      0
    end
  end
end
