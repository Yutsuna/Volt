@[External]
def __volt_format_float( val : Float64, buf : UInt8* ) -> Int32


struct Float include Inspectable

  #----------------------------------------------------------------------------

  def to_string -> String
    buf : UInt8* = malloc( 64 )
    len = __volt_format_float( self, buf )
    if len < 0
      free( buf )
      return "0.0"
    end

    precise : UInt8* = malloc( len + 1 )
    memcpy( precise, buf, len + 1 )
    free( buf )

    String.new( precise, len, true )
  end

  #----------------------------------------------------------------------------

end
