# Assigning a subtype to an abstract base class by value or calling an abstract
# method directly on a static type without dynamic dispatch must be rejected
# cleanly during semantic analysis.

class AbstractShape
  abstract def area -> Int32
end

class Rect < AbstractShape
  getter width : Int32
  getter height : Int32

  def initialize( @width : Int32, @height : Int32 )
  end

  def area -> Int32
    @width * @height
  end
end

s : AbstractShape = Rect.new( 4, 5 )
