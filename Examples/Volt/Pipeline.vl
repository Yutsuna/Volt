@[External( "libc" )]
def puts( str : String ) -> Void

def capitalize_all( words : Array[String] ) -> Array[String]
  words.map { |word| word.capitalize }
end

def join_with( words : Array[String], separator : String ) -> String
  words.join( separator )
end

raw_data = "   apple,  banana,   , cherry, date, elderberry   "
processed_result = raw_data
  |> strip
  |> split(",")
  |> map { |item| item.strip }
  |> reject { |item| item.empy? }
  |> capitalize_all
  |> join_with( " -> ")

puts raw_data
puts "VS result:"
puts processed_result
