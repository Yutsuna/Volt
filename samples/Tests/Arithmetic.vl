@[External( "libc", "exit" )]
external def libc_exit( value : Int32 ) -> Void

def assert!( condition : Bool ) -> Void
  if not condition
    raise "FAIL #{__FILE__}:\nCalled by#{__FUNCTION__} at #{__LINE__}:#{__COLUMN__}"
  end
end

#------------------------------------------------------------------------------

def test_int8 -> Void
  a : Int8 = 10
  b : Int8 = 5
  zero : Int8 = 0
  neg : Int8 = -5

  assert!( a + b == 15 )
  assert!( a - b == 5 )
  assert!( a * b == 50 )
  assert!( a / b == 2 )
  assert!( a % b == 0 )
  assert!( ( a & b ) == 0 )
  assert!( ( a | b ) == 15 )
  assert!( ( a ^ b ) == 15 )
  assert!( ( b << 1 ) == 10 )
  assert!( ( a >> 1 ) == 5 )
  assert!( ~zero == -1 )

  assert!( a.negate == -10 )
  assert!( neg.abs == 5 )
  assert!( a.min( b ) == 5 )
  assert!( a.max( b ) == 10 )
  assert!( a.successor == 11 )
  assert!( a.predecessor == 9 )
  assert!( a.between?( 1, 20 ) )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( neg.negative? )
  assert!( a.even? )
  assert!( b.odd? )
  assert!( ( 8 : Int8 ).power_of_two? )
  assert!( a.divisible_by?( b ) )
  assert!( a.clamp( 1, 5 ) == 5 )
  assert!( a.distance( b ) == 5 )
  assert!( b.square == 25 )
  assert!( b.double == 10 )
  assert!( a.half == 5 )
  assert!( b.cube == 125 )
  assert!( ( 2 : Int8 ).pow( 3 ) == 8 )
end

def test_int16 -> Void
  a : Int16 = 1000
  b : Int16 = 2000
  zero : Int16 = 0
  neg : Int16 = -500

  assert!( a + b == 3000 )
  assert!( b - a == 1000 )
  assert!( a * 2 == 2000 )
  assert!( b / 2 == 1000 )
  assert!( b % a == 0 )
  assert!( ( a & b ) == 960 )
  assert!( ( a | b ) == 2040 )
  assert!( ( a ^ b ) == 1080 )
  assert!( ( a << 1 ) == 2000 )
  assert!( ( b >> 1 ) == 1000 )
  assert!( ~zero == -1 )

  assert!( a.negate == -1000 )
  assert!( neg.abs == 500 )
  assert!( a.min( b ) == 1000 )
  assert!( a.max( b ) == 2000 )
  assert!( a.successor == 1001 )
  assert!( a.predecessor == 999 )
  assert!( a.between?( 500, 1500 ) )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( neg.negative? )
  assert!( a.even? )
  assert!( ( 1001 : Int16 ).odd? )
  assert!( ( 1024 : Int16 ).power_of_two? )
  assert!( b.divisible_by?( a ) )
  assert!( a.clamp( 200, 800 ) == 800 )
  assert!( a.distance( b ) == 1000 )
  assert!( ( 10 : Int16 ).square == 100 )
  assert!( a.double == 2000 )
  assert!( b.half == 1000 )
  assert!( ( 10 : Int16 ).cube == 1000 )
  assert!( ( 3 : Int16 ).pow( 3 ) == 27 )
end

def test_int32 -> Void
  a : Int32 = 100000
  b : Int32 = 50000
  zero : Int32 = 0
  neg : Int32 = -123456

  assert!( a + b == 150000 )
  assert!( a - b == 50000 )
  assert!( a * b == 5000000000 )
  assert!( a / b == 2 )
  assert!( a % b == 0 )
  assert!( ( a & b ) == 32768 )
  assert!( ( a | b ) == 117232 )
  assert!( ( a ^ b ) == 84464 )
  assert!( ( b << 1 ) == 100000 )
  assert!( ( a >> 1 ) == 50000 )
  assert!( ~zero == -1 )

  assert!( a.negate == -100000 )
  assert!( neg.abs == 123456 )
  assert!( a.min( b ) == 50000 )
  assert!( a.max( b ) == 100000 )
  assert!( a.successor == 100001 )
  assert!( a.predecessor == 99999 )
  assert!( a.between?( 0, 200000 ) )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( neg.negative? )
  assert!( a.even? )
  assert!( ( 100001 : Int32 ).odd? )
  assert!( ( 65536 : Int32 ).power_of_two? )
  assert!( a.divisible_by?( b ) )
  assert!( a.clamp( 0, 1000 ) == 1000 )
  assert!( a.distance( b ) == 50000 )
  assert!( ( 1000 : Int32 ).square == 1000000 )
  assert!( b.double == 100000 )
  assert!( a.half == 50000 )
  assert!( ( 100 : Int32 ).cube == 1000000 )
  assert!( ( 2 : Int32 ).pow( 10 ) == 1024 )
end

def test_int64 -> Void
  a : Int64 = 10000000000
  b : Int64 = 5000000000
  zero : Int64 = 0
  neg : Int64 = -9999999999

  assert!( a + b == 15000000000 )
  assert!( a - b == 5000000000 )
  assert!( a / b == 2 )
  assert!( a % b == 0 )

  assert!( a.negate == -10000000000 )
  assert!( neg.abs == 9999999999 )
  assert!( a.min( b ) == 5000000000 )
  assert!( a.max( b ) == 10000000000 )
  assert!( a.successor == 10000000001 )
  assert!( a.predecessor == 9999999999 )
  assert!( zero.zero? )
  assert!( a.non_zero? )
  assert!( a.positive? )
  assert!( neg.negative? )
  assert!( a.even? )
  assert!( ( 10000000001 : Int64 ).odd? )
  assert!( ( 1073741824 : Int64 ).power_of_two? )
  assert!( a.divisible_by?( b ) )
  assert!( a.distance( b ) == 5000000000 )
  assert!( b.double == 10000000000 )
  assert!( a.half == 5000000000 )
  assert!( ( 2 : Int64 ).pow( 30 ) == 1073741824 )
end


