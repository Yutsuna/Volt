macro assert( condition )
  if {{ condition }}
    puts "PASS"
  else
    puts "FAIL"
  end
end


# --- hash literal : String keys ------------------------------------------------

scores = { "Alice" => 10, "Bob" => 15 }
assert( scores["Alice"] == 10 )
assert( scores["Bob"] == 15 )
assert( scores.size == 2 )

# --- update & insert -----------------------------------------------------------

scores["Alice"] = 99
assert( scores["Alice"] == 99 )
assert( scores.size == 2 )

scores["Carol"] = 7
assert( scores["Carol"] == 7 )
assert( scores.size == 3 )

# --- has_key? / fetch / delete -------------------------------------------------

assert( scores.has_key?("Bob") )
assert( !scores.has_key?("Eve") )
assert( scores.fetch("Eve", -1) == -1 )
assert( scores.fetch("Bob", -1) == 15 )

assert( scores.delete("Bob") )
assert( !scores.delete("Bob") )
assert( !scores.has_key?("Bob") )
assert( scores.size == 2 )

# --- reinsert after delete (tombstone reuse) -----------------------------------

scores["Bob"] = 1
assert( scores["Bob"] == 1 )
assert( scores.size == 3 )

# --- empty? / clear ------------------------------------------------------------

assert( !scores.empty? )
scores.clear
assert( scores.empty? )
assert( scores.size == 0 )

# --- `of` : empty literal, explicitly typed ------------------------------------

inventaire = {} of String => Int32
inventaire["pommes"] = 5
inventaire["bananes"] = 12
assert( inventaire["pommes"] == 5 )
assert( inventaire["bananes"] == 12 )
assert( inventaire.size == 2 )

# --- Int keys / String values --------------------------------------------------

ages = { 1 => 100, 2 => 200 }
assert( ages[2] == 200 )

names = { 1 => "un" }
assert( names[1] == "un" )
assert( names.to_string == "{1 => un}" )

# --- Symbol keys : `:sym =>` and `key:` shorthand ------------------------------

options = { :vitesse => 100 }
assert( options[:vitesse] == 100 )
assert( options.to_string == "{vitesse => 100}" )

rapides = { vitesse: 100, unites: 42 }
assert( rapides[:vitesse] == 100 )
assert( rapides[:unites] == 42 )
assert( rapides.size == 2 )

# --- symbols are interned integers ---------------------------------------------

a = :vitesse
b = :vitesse
assert( a == b )
assert( a != :unites )
assert( a.to_int == b.to_int )
assert( a.hash == b.hash )
assert( a.to_string == "vitesse" )

# --- growth : enough inserts to force several rehashes -------------------------

big = {} of Int => Int
i = 0
while i < 500
  big[i] = i * 2
  i += 1
end
assert( big.size == 500 )
assert( big[250] == 500 )
assert( big.keys.size == 500 )
assert( big.values.size == 500 )

ok = true
i = 0
while i < 500
  ok = false if big[i] != i * 2
  i += 1
end
assert( ok )

# --- Float / Bool / Pointer keys (Hashable primitives) --------------------------

fh = { 1.5 => "un", 2.5 => "deux" }
assert( fh[1.5] == "un" )
assert( fh[2.5] == "deux" )
assert( 0.0.hash == -0.0.hash )

bh = { true => "oui", false => "non" }
assert( bh[true] == "oui" )
assert( bh[false] == "non" )

p = Pointer[ UInt8 ].malloc( 4_u64 )
assert( p.hash == p.hash )
p.free
