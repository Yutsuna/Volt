@[External]
def puts( str : String ) -> Void

macro assert( condition )
  if {{ condition }}
    puts "PASS"
  else
    raise "FAIL"
  end
end


def test_unary_operators
  max = 127_i8
  min = -128_i8

  assert(+max == 127)
  assert(-max == -127)
  assert(!true == false)
  assert(~1 == -2)
end

def test_multiplicative_operators
  assert(2 ** 3 == 8)
  assert(2 &** 3 == 8)

  assert(2 * 3 == 6)
  assert(127_i8 &* 2 == -2)
  assert(10 / 2 == 5.0)
  assert(10 // 3 == 3)
  assert(10 % 3 == 1)
end

def test_additive_operators
  assert(1 + 2 == 3)
  assert(127_i8 &+ 1 == -128)
  assert(1 - 2 == -1)
  assert(-128_i8 &- 1 == 127)
end

def test_shifts
  assert(1 << 2 == 4)
  assert(4 >> 2 == 1)
end

def test_binary_operators
  assert((1 & 3) == 1)
  assert((1 | 2) == 3)
  assert((1 ^ 3) == 2)
end

def test_relational_operators
  assert(1 == 1)
  assert(1 != 2)
  assert(1 < 2)
  assert(1 <= 1)
  assert(2 > 1)
  assert(2 >= 2)
  assert((1 <=> 2) == -1)

  assert("abc" =~ /a/)
  assert("abc" !~ /d/)
  assert(1 === 1)
  assert(/foo/ === "foo")
end

def test_logical_operators
  assert(true && true)
  assert(true || false)
end

def test_range_operators
  assert((1..3).includes?(2))
  assert((1...3).includes?(2))
end

def test_assignment_operators
  a = 1
  a += 2
  assert(a == 3)

  a = 127_i8
  a &+= 1
  assert(a == -128)

  a = 5
  a -= 2
  assert(a == 3)

  a = 5
  a *= 2
  assert(a == 10)

  a = 10
  a //= 3
  assert(a == 3)

  a = 10
  a %= 3
  assert(a == 1)

  a = 1
  a |= 2
  assert(a == 3)

  a = 3
  a &= 1
  assert(a == 1)

  a = 1
  a ^= 2
  assert(a == 3)
end

test_unary_operators
test_multiplicative_operators
test_additive_operators
test_shifts
test_binary_operators
test_relational_operators
test_logical_operators
test_range_operators
test_assignment_operators
