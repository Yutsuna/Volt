struct Int include Inspectable

  # alias Signed = Int8 | Int16 | Int32 | Int64
  # alias Unsigned = UInt8 | UInt16 | UInt32 | UInt64

  # NOTE: unsafe should be macro'd aand dynamic depending on the target of Int
  # MIN : Int = -9223372036854775808
  # MAX : Int = 9223372036854775807

  #----------------------------------------------------------------------------

  def abs -> Int
    self >= 0 ? self : -self
  end

  def min( other : Int ) -> Int
   self < other ? self : other
  end

  def divisible_by?( other : Int ) -> Bool
    other != 0 && self % other == 0
  end

  def even? -> Bool
    divisible_by? 2
  end

  def odd? -> Bool
    !even?
  end

  def successor -> Int
    self + 1
  end

  def predecessor -> Int
    self - 1
  end

  #----------------------------------------------------------------------------

  def to_string -> String
    if self == 0
      return "0"
    end

    neg = self < 0
    n   = neg ? ( 0 - self ) : self

    count = 0
    tmp   = n
    while tmp > 0
      tmp   = tmp / 10
      count = count + 1
    end

    total        = neg ? count + 1 : count
    buf : UInt8* = malloc( total )

    idx = total - 1
    rem = n
    while rem > 0
      digit          = rem % 10
      *( buf + idx ) = 48_u8 + digit
      rem            = rem / 10
      idx            = idx - 1
    end
    *( buf + idx ) = 45_u8 if neg

    String.new( buf, total, true )
  end

  #----------------------------------------------------------------------------

end
