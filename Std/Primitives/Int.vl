@[External("libc")]
def snprintf( buf : UInt8*, size : Int, format : String, value : Int ) -> Int


struct Int include Inspectable

  # alias Signed = Int8 | Int16 | Int32 | Int64
  # alias Unsigned = UInt8 | UInt16 | UInt32 | UInt64

  # NOTE: unsafe should be macro'd aand dynamic depending on the target of Int
  # MIN_64 : Int = -9223372036854775808
  # MAX_32 : Int = 9223372036854775807

  #----------------------------------------------------------------------------

  def abs -> Int
    self >= 0 ? self : -self
  end

  def min( other : Int ) -> Int
   self < other ? self : other
  end

  def divisible_by?( other : Int ) -> Bool
    other != 0 && self % other == 0
  end

  def even? -> Bool
    divisible_by? 2
  end

  def odd? -> Bool
    !even?
  end

  def successor -> Int
    self + 1
  end

  def predecessor -> Int
    self - 1
  end

  #----------------------------------------------------------------------------

  def to_string -> String
    "0" if self == 0
    buf : UInt8[ 20 ]
    digits = snprintf( buf, 20, "%d", self )
    String.new( buf, digits, false )
  end

  #----------------------------------------------------------------------------

end
