module MathTools

  extend self

  @@operation_count : Int32 = 0

  def square( x : Int32 ) -> Int32
    @@operation_count += 1
    x * x
  end

  def cube( x : Int32 ) -> Int32
    @@operation_count += 1
    x * x * x
  end

  def total_operations() -> Int32
    @@operation_count
  end

end


if not MathTools.square( 5 ) == 25 and not MathTools.cube( 3 ) == 27 and not MathTools.total_operations() == 2
  puts( "FAIL" )
else
  puts( "PASS" )
end
